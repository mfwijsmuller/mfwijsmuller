# ─────────────────────────────────────────────────────────────────────────────
# Shopify Quiz App — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Shopify App Credentials ──────────────────────────────────────────────────
# Found in your Partner Dashboard under App setup > API credentials
SHOPIFY_API_KEY=your_shopify_api_key_here
SHOPIFY_API_SECRET=your_shopify_api_secret_here

# ── App URL ──────────────────────────────────────────────────────────────────
# The public URL of your app (used for OAuth redirects and webhooks).
# In local dev, Shopify CLI sets this automatically via ngrok/cloudflare tunnel.
SHOPIFY_APP_URL=https://your-app.example.com

# ── OAuth Scopes ─────────────────────────────────────────────────────────────
# Must match what's in shopify.app.toml
SCOPES=read_customers,write_customers,read_customer_metafields,write_customer_metafields

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite (default for local dev):
DATABASE_URL=file:./dev.db

# PostgreSQL (recommended for production):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME

# ── Optional ─────────────────────────────────────────────────────────────────
# NODE_ENV=development
# PORT=3000
# SHOP_CUSTOM_DOMAIN=my-store.example.com   # if you use a custom domain
